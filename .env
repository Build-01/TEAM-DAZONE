# Database - Replace with your PostgreSQL connection string
# For development, use Neon.tech (free): https://neon.tech
# Or local PostgreSQL: postgresql://username:password@localhost:5432/sabiwork
DATABASE_URL="postgresql://username:password@your-host:5432/sabiwork"

# Server
NODE_ENV="development"
PORT=3000
LOG_LEVEL="info"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRY="7d"

# Squad API
SQUAD_API_KEY="your-squad-api-key-here"
SQUAD_API_BASE_URL="https://api.sandbox.squad.co"
SQUAD_MERCHANT_ID="your-merchant-id"
SQUAD_MERCHANT_EMAIL="merchant@example.com"

# Redis
REDIS_URL="redis://localhost:6379"

# AI Service
HUGGINGFACE_API_KEY="your-huggingface-api-key"

# Application
APP_NAME="sabiwork"
APP_VERSION="1.0.0"
FRONTEND_URL="http://localhost:3001"
